# Copy to .env and fill in. .env is gitignored.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Jev (System One) route on OpenRouter. Decisions endpoint, not chat.
JEV_MODEL=~typesafe/jev-latest

# The LLM (System Two) used for generation and as the fail-safe fallback.
# Cheap good default; ":free" variants also work.
LLM_MODEL=qwen/qwen3.7-flash

# Model used only to compile a natural-language decision into a typed Jev
# schema (once per task shape, then cached). Keep it cheap.
COMPILER_MODEL=qwen/qwen3.7-flash

# Server
HOST=127.0.0.1
PORT=8765
